{
  "extends": "./tsconfig.json",
  "include": ["server/**/*", "shared/**/*"],
  "exclude": [
    "client/**/*",
    "node_modules",
    "build",
    "dist",
    "**/*.test.ts",
    "shared/hydration/**/*.contract-check.ts"
  ],
  "compilerOptions": {
    "target": "ES2020",
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false
  }
}
