{
  "appId": "com.myperfectmeals.app",
  "appName": "My Perfect Meals",
  "webDir": "client/dist",
  "server": {
    "url": "https://app.myperfectmeals.ai",
    "cleartext": false
  },
  "ios": {
    "backgroundColor": "#000000",
    "scrollEnabled": false,
    "contentInset": "automatic"
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "launchShowDuration": 5000,
      "backgroundColor": "#000000",
      "androidScaleType": "CENTER_CROP",
      "fadeOutDuration": 300,
      "showSpinner": false
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_icon_config_sample",
      "iconColor": "#FF6B00",
      "sound": "default"
    }
  }
}
